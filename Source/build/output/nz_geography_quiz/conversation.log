<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Zealand Geography Quiz</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body>
    <header>
        <h1>New Zealand Geography Quiz</h1>
        <p>Test your knowledge of New Zealand's towns and cities! Identify locations based on geographic clues.</p>
        <div class="question-number">Question <span id="current-question">1</span> of <span id="total-questions">5</span></div>
    </header>

    <main>
        <div class="question-content">
            <p id="geographic-clue">This city is located on the North Island and is known for its geothermal features and as a gateway to Tongariro National Park.</p>
        </div>

        <form method="POST" action="process_answer.php" id="quiz-form">
            <input type="hidden" name="question_id" value="1">
            <input type="hidden" name="total_questions" value="5">
            <input type="hidden" name="current_question" value="1">

            <div class="answer-input">
                <label for="town-name">Enter town or city name:</label>
                <input type="text" id="town-name" name="town_name" placeholder="Enter town or city name" required>
            </div>

            <div class="feedback-message" id="feedback-message"></div>

            <div class="navigation-buttons">
                <button type="button" id="prev-button" class="nav-btn">Previous Question</button>
                <button type="submit" id="check-button" class="nav-btn">Check Answer</button>
                <button type="button" id="next-button" class="nav-btn">Next Question</button>
            </div>
        </form>
    </main>

    <footer>
        <p>&copy; 2023 New Zealand Geography Quiz. All rights reserved.</p>
        <p><a href="index.php">Back to Home</a></p>
    </footer>

    <script>
        // Basic JavaScript for handling navigation
        document.getElementById('prev-button').addEventListener('click', function() {
            // Logic to go to previous question would be implemented here
            alert('Previous button clicked');
        });

        document.getElementById('next-button').addEventListener('click', function() {
            // Logic to go to next question would be implemented here
            alert('Next button clicked');
        });
    </script>
</body>
</html>
